<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gyan_bg_dark"
    tools:context=".MainActivity">

    <!-- Top Futuristic Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gyan_bg_surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/gyan_text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/gyan_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Portfolio Pill Badge -->
            <TextView
                android:id="@+id/badgePortfolio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_tag"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="GyanXD25"
                android:textColor="@color/gyan_gold_bright"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Status/Message bar -->
        <TextView
            android:id="@+id/textViewError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/gyan_gold_bright"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Content Switcher -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <!-- TAB 1: APPS HUB -->
        <LinearLayout
            android:id="@+id/tabHubLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Car Screen Visibility Helper Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAAGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/gyan_bg_card"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/gyan_gold_bright"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="🚗"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apps not showing on your car screen?"
                            android:textColor="@color/gyan_gold_bright"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap to enable Unknown Sources &amp; fix Android 14+ setup"
                            android:textColor="@color/gyan_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="FIX ➔"
                        android:textColor="@color/gyan_cyan_neon"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppsHub"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- TAB 2: FILE INSTALLER (Original KingInstaller features) -->
        <ScrollView
            android:id="@+id/tabInstallerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- APK Picker Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/gyan_bg_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/gyan_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_apk_to_install"
                            android:textColor="@color/gyan_text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selectButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_button_gradient"
                            android:text="@string/select_file"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_menu_search"
                            app:iconTint="@color/white" />

                        <TextView
                            android:id="@+id/selectedFileText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_chip_tag"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textColor="@color/gyan_blue_glow"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Installation Method Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/gyan_bg_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/gyan_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/installation_method"
                            android:textColor="@color/gyan_text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchOppo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/oppo_trick"
                            android:textColor="@color/gyan_text_main" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRoot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/root_trick"
                            android:textColor="@color/gyan_text_main" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchShizuku"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/shizuku_trick"
                            android:textColor="@color/gyan_text_main" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Main Install Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/installButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_button_gradient"
                    android:text="@string/install_as_king"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconTint="@color/white" />

                <!-- Action shortcuts: Check apps & AA settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkInstallerButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/check_app_installer"
                        android:textColor="@color/gyan_text_main"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/gyan_border_subtle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openAndroidAutoButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_android_auto_short"
                        android:textColor="@color/gyan_text_main"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/gyan_border_subtle" />
                </LinearLayout>

                <!-- Reset buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resetButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/reset_default"
                        android:textColor="@color/gyan_text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reinstallGoogleButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/reinstall_google_installer"
                        android:textColor="@color/gyan_text_muted" />
                </LinearLayout>

                <!-- Hidden donate buttons retained for code compatibility -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">
                    <ImageButton android:id="@+id/donatePayPalButton" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageButton android:id="@+id/donateCoffeeButton" android:layout_width="0dp" android:layout_height="0dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: SETTINGS & ABOUT -->
        <ScrollView
            android:id="@+id/tabSettingsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Developer & License Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/gyan_bg_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/gyan_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gyan AAD Hub"
                            android:textColor="@color/gyan_text_main"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/copyright_notice"
                            android:textColor="@color/gyan_gold_bright"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/jen94"
                            android:textColor="@color/gyan_text_muted"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenPortfolio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_button_gradient"
                            android:text="@string/visit_portfolio"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_menu_compass"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tools Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/gyan_bg_card"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/gyan_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Utilities &amp; Links"
                            android:textColor="@color/gyan_text_main"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsAAGuide"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="🚗 Car Visibility Setup Guide"
                            android:textColor="@color/gyan_gold_bright"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gyan_gold_bright" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsCheckApps"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/check_app_installer"
                            android:textColor="@color/gyan_text_main"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gyan_border_subtle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsOpenAA"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/open_android_auto"
                            android:textColor="@color/gyan_text_main"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gyan_border_subtle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsCheckUpdates"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_check_update"
                            android:textColor="@color/gyan_text_main"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gyan_border_subtle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gyan_bg_card"
        app:itemIconTint="@color/selector_nav_color"
        app:itemTextColor="@color/selector_nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
